{
  "name": "pr-quest",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Gamified dashboard for the PRs you're asked to review, with Cursor review agents",
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": ">=24.x",
    "yarn": "4.13.0"
  },
  "volta": {
    "node": "24.22.1",
    "yarn": "4.13.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,ui --prefix-colors cyan,magenta \"tsx watch src/server/main.ts\" \"vite\"",
    "start": "concurrently --kill-others --names api,ui --prefix-colors cyan,magenta \"tsx src/server/main.ts\" \"vite\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "build": "yarn typecheck && vite build"
  },
  "dependencies": {
    "@cursor/sdk": "1.0.40",
    "@fontsource/press-start-2p": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "25.9.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "10.0.6",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "jsdom": "30.1.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
