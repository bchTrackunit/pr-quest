{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PR Quest",
  "version": "../package.json",
  "identifier": "com.prquest.desktop",
  "build": {
    "frontendDist": "./splash"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'none'",
      "capabilities": [{ "identifier": "none", "windows": [], "permissions": [] }]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Turn your pull requests into a quest",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/pr-quest-node"],
    "resources": {
      "../build-tauri/sidecar/": "sidecar/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "./entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libdbus-1-3"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDNkFDNThCNDIyNzQyN0QKUldSOVFpZENpOFZxektLT0Yzb0U3QnBLc2FwU2NzUUdjdzRnR1A1K3BMYnQ3S21XL1Fua0hNRmkK",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
