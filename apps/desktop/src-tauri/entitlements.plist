<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- The Node sidecar's V8 compiles JavaScript at run time, which the hardened runtime blocks without this.
         Tauri signs the shell and its externalBin with this one file, so the shell has it too. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
