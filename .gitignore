# dependencies
node_modules/

# Yarn 4: keep the project's plugins, patches, releases and sdks, ignore the rest
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# build and test output
dist/
dist-server/
dist-desktop/
release/
coverage/
build-tauri/
src-tauri/target/
src-tauri/binaries/
src-tauri/gen/

# local secrets
.env.local
.env.*.local

# misc
.DS_Store
.idea/
*.log
