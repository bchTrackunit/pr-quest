# dependencies
node_modules/

# Yarn 4: keep the project's plugins, patches, releases and sdks, ignore the rest
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# build and test output
dist/
coverage/
apps/desktop/build-tauri/
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/binaries/
apps/desktop/src-tauri/gen/

# local secrets
.env.local
.env.*.local

# misc
.DS_Store
.idea/
*.log
