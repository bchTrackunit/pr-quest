{
  "name": "pr-quest",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/pr-quest/src",
  "tags": ["type:app", "scope:tool", "dependencies:no-deprecated"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "cache": false,
      "options": {
        "cwd": "apps/pr-quest",
        "parallel": true,
        "commands": ["tsx watch src/server/main.ts", "vite"]
      }
    },
    "tsc-validate": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/pr-quest",
        "command": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.spec.json --noEmit"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["tsc-validate"],
      "outputs": ["{workspaceRoot}/dist/apps/pr-quest"],
      "options": {
        "cwd": "apps/pr-quest",
        "command": "vite build"
      }
    }
  }
}
