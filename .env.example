# Copy to .env.local (git-ignored) and run `chmod 600 .env.local`.
# Environment variables take precedence over values in .env.local.

# Enables "Send review agent". Create one at https://cursor.com/dashboard/integrations
CURSOR_API_KEY=

# Optional Linear enrichment: review page links and the "needs attention" flag
LINEAR_API_KEY=

# Optional settings (defaults shown)
# PR_QUEST_PORT=4317
# PR_QUEST_UI_PORT=4318
# PR_QUEST_STATE_DIR=~/.pr-quest
