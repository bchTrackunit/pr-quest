# Copy to ~/.pr-quest/.env (the state directory) and run `chmod 600 ~/.pr-quest/.env`.
# A git-ignored .env.local at the repo root still works too, with the lowest precedence.
# Environment variables take precedence over both files.
# The API keys can also be set in the app's settings popup instead.

# Cursor reviews. Create one at https://cursor.com/dashboard/integrations
CURSOR_API_KEY=

# Claude reviews. Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional Linear enrichment: review page links and the "needs attention" flag
LINEAR_API_KEY=

# Client ID of a GitHub OAuth App with Device Flow enabled, for "Sign in with GitHub".
# Not a secret. See the README's "Sign in with GitHub" section.
PR_QUEST_GITHUB_CLIENT_ID=

# Optional settings (defaults shown)
# PR_QUEST_PORT=4317
# PR_QUEST_UI_PORT=4318
# PR_QUEST_STATE_DIR can't be set here; set it in the environment or .env.local.

# Hosted mode only (PR_QUEST_MODE=hosted); see "Hosted storage" in docs/development.md.
# Prefer your platform's secret store over this file for these.
# DATABASE_URL=postgres://user:password@host:5432/pr_quest
# 32 random bytes, base64: openssl rand -base64 32
# PR_QUEST_MASTER_KEY=
# Comma-separated master keys being rotated out
# PR_QUEST_PREVIOUS_MASTER_KEYS=
# Connections per server instance, 1 to 100 (default 10)
# PR_QUEST_DATABASE_POOL_MAX=
